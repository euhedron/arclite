#!/usr/bin/env bash
# arclite pre-push gate — not canon; edit freely. Skip once: ARC_GATE=0 git push.
if [ "$ARC_GATE" = "0" ]; then
    echo "arclite gate: skipped (ARC_GATE=0)" >&2
    exit 0
fi

zero=0000000000000000000000000000000000000000
branch_push=0
while read -r local_ref local_sha _rest; do
    [ "$local_sha" = "$zero" ] && continue
    case "$local_ref" in
    refs/tags/*) git merge-base --is-ancestor "$local_sha" origin/main 2>/dev/null || branch_push=1 ;;
    *) branch_push=1 ;;
    esac
done
if [ "$branch_push" -eq 0 ]; then
    echo "arclite gate: push moves no ungated commits — skipping" >&2
    exit 0
fi

echo "=== arclite gate · cargo fmt / clippy / test ===" >&2
cargo fmt --check >&2 || { echo "arclite gate: BLOCKED — cargo fmt (run 'cargo fmt')." >&2; exit 1; }
cargo clippy --all-targets --locked -- -D warnings >&2 || { echo "arclite gate: BLOCKED — cargo clippy." >&2; exit 1; }
cargo test --locked >&2 || { echo "arclite gate: BLOCKED — cargo test." >&2; exit 1; }

set --
if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
    while IFS= read -r -d '' f; do set -- "$@" --include "./$f"; done \
        < <(git diff --name-only --diff-filter=d -z origin/main..HEAD -- src 2>/dev/null)
fi

gate_out=$(mktemp)
arc run audit . --include src --findings --fail-on-findings >"$gate_out" 2>&1 &
gate_pid=$!
align_out=$(mktemp)
arc run align . "$@" --fail-on-findings >"$align_out" 2>&1 &
align_pid=$!
wait "$gate_pid"; gate=$?
wait "$align_pid"; align=$?

echo "=== arclite gate · audit ===" >&2; cat "$gate_out" >&2; rm -f "$gate_out"
echo "=== arclite gate · align ===" >&2; cat "$align_out" >&2; rm -f "$align_out"
[ "$gate" -ne 0 ] && { echo "arclite gate: blocked (audit $gate) · arc log --last --command audit · ARC_GATE=0 to skip" >&2; exit "$gate"; }
[ "$align" -ne 0 ] && { echo "arclite gate: blocked (align $align) · arc log --last --command align · ARC_GATE=0 to skip" >&2; exit "$align"; }

if git rev-parse --verify --quiet origin/main >/dev/null 2>&1 && [ -n "$(git diff --name-only --diff-filter=d origin/main..HEAD -- .arc/rules .arc/meta-rules 2>/dev/null)" ]; then
    echo "=== arclite meta-gate · rule-quality ===" >&2
    arc run audit . --include .arc/rules --ruleset rule-quality --no-scan --fail-on-findings >&2 \
        || { echo "arclite meta-gate: BLOCKED." >&2; exit 1; }
fi
exit 0
